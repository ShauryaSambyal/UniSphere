# Copy to client/.env for the values you need.

# Base URL of the deployed backend (no trailing slash and no /api suffix),
# e.g. https://unisphere-api.onrender.com
#
# Leave empty for local development: Vite proxies /api to http://localhost:5000
# (see vite.config.js), so no value is required to run the app locally.
VITE_API_URL=
