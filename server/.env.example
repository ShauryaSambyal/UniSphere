# Copy to server/.env (takes priority) or to the repository root .env and fill in
# what you have. Only MONGODB_URI and JWT_SECRET are required — every external
# integration below degrades to a local fallback when its key is left empty.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of extra browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/college-platform

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ─── Google Gemini — AI summaries and RAG chat (mocked when empty) ───────────
GEMINI_API_KEY=

# ─── Google Maps Places — nearby facilities (mocked when empty) ──────────────
GOOGLE_MAPS_API_KEY=

# ─── Algolia search — autocomplete + index sync (MongoDB regex when empty) ───
ALGOLIA_APP_ID=

# Write key: creates/updates/deletes index records. Server-side only.
ALGOLIA_WRITE_API_KEY=

# Search key: query-only, least privilege.
ALGOLIA_SEARCH_API_KEY=

ALGOLIA_INDEX_NAME=colleges

# ─── ChromaDB vector store — RAG retrieval (MongoDB search when offline) ─────
CHROMADB_HOST=http://localhost:8000

# ─── Optional alternative chat provider ──────────────────────────────────────
LLAMA_API_KEY=
